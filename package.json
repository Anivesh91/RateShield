{
  "name": "smart-rate",
  "version": "5.0.0",
  "description": "Production-ready distributed rate limiting middleware for Express.js supporting Fixed Window, Rolling Sliding Window, and Token Bucket + Burst Control algorithms with custom identity and dynamic tier-based policies",
  "type": "module",
  "main": "./src/index.js",
  "exports": "./src/index.js",
  "scripts": {
    "dev": "node --watch examples/express-demo/server.js",
    "start": "node examples/express-demo/server.js",
    "demo:multi": "node examples/express-demo/multi-instance.js",
    "demo:sliding": "node examples/express-demo/sliding-demo.js",
    "demo:saas": "node examples/express-demo/saas-demo.js",
    "demo:burst": "node examples/express-demo/burst-demo.js",
    "test": "node --test"
  },
  "keywords": [
    "rate-limiter",
    "express",
    "middleware",
    "fixed-window",
    "sliding-window",
    "rolling-window",
    "token-bucket",
    "multi-tenant",
    "dynamic-policy",
    "in-memory",
    "redis",
    "distributed",
    "lua",
    "zset",
    "smart-rate"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "supertest": "^7.0.0"
  },
  "dependencies": {
    "redis": "^6.2.1"
  }
}
